{
  "name": "@uap/apps",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:directory": "cd directory && npm run dev",
    "dev:scheduler": "cd scheduler && npm run dev",
    "dev:marketplace": "cd marketplace && npm run dev",
